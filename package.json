{
  "devDependencies": {
    "@types/animejs": "^3.1.13",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "animejs": "3.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.9.1",
    "front-matter": "^4.0.2",
    "medium-zoom": "^1.1.0",
    "typescript": "5.6.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.16",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.8"
  },
  "scripts": {
    "dev": "pnpm run generate-data && vitepress dev docs",
    "build": "pnpm run generate-data && vitepress build docs",
    "lint": "eslint \"docs/.vitepress/theme/**/*.{ts,vue}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:theme": "node docs/.vitepress/scripts/check-theme-constraints.js",
    "preview": "vitepress preview docs",
    "generate-site-data": "node docs/.vitepress/scripts/generate-site-data.js",
    "generate-recommended": "node docs/.vitepress/scripts/generate-recommended-data.js",
    "generate-contributions": "node docs/.vitepress/scripts/generate-daily-contributions.js",
    "generate-data": "pnpm run generate-site-data && pnpm run generate-recommended && pnpm run generate-contributions"
  },
  "dependencies": {
    "@vueuse/core": "^13.3.0",
    "@waline/client": "^3.5.7",
    "echarts": "^5.6.0",
    "gray-matter": "^4.0.3"
  },
  "type": "module"
}
